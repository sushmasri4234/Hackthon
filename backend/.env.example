# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://certiflow:certiflow_secret@localhost:5432/certiflow?schema=public"

# Redis & Queue Configuration
REDIS_URL="redis://localhost:6379"

# Security & Authentication
JWT_SECRET="certiflow_super_secret_jwt_key_2024_secure"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_SECRET="certiflow_super_secret_refresh_jwt_key_2024"
JWT_REFRESH_EXPIRES_IN="7d"

# Workflow & Business Rules
LARGE_BATCH_THRESHOLD=50
APPROVAL_DEADLINE_HOURS=48
AUTO_ESCALATE_HOURS=72

# Storage & Assets
CERTIFICATE_STORAGE_PATH="./certificates"
PUBLIC_VERIFY_BASE_URL="http://localhost:5173/verify"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
